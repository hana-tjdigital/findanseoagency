---
import Base from '../layouts/Base.astro';
import { getEmDashEntry, getEmDashCollection } from 'emdash';

const [pageRes, postsRes] = await Promise.all([
  getEmDashEntry('pages', 'home'),
  getEmDashCollection('posts', { orderBy: { display_order: 'asc' }, limit: 4 }),
]);
const { entry: page, cacheHint: pageCH } = pageRes;
const { entries: posts } = postsRes;

Astro.cache.set(pageCH);

const sections = page?.data?.sections || {};
const featuredPost = posts.find((p: any) => p.data.featured);
const recentPosts = posts.filter((p: any) => !p.data.featured && p.data.featured_image).slice(0, 3);
---

<Base title={page?.data?.seo_title || 'FindAnSEOAgency'} description={page?.data?.seo_description} activeNav="/">
  <main>

    <!-- ═══════ HERO ═══════ -->
    <div class="h-screen p-3 md:p-5 flex flex-col">
    <section id="hero" class="mesh-dark grain relative overflow-hidden flex-grow rounded-[1.5rem] md:rounded-[2rem]" style="border-bottom-right-radius: 0;">
      <canvas id="hero-canvas" class="absolute inset-0 z-[1]" aria-hidden="true"></canvas>

      <div class="relative z-[3] flex flex-col justify-end h-full px-8 md:px-14 pb-40">
        {page?.data?.hero_eyebrow && (
          <div class="section-label text-orange-light mb-6">{page.data.hero_eyebrow}</div>
        )}
        <h1 class="font-display text-[clamp(2.8rem,7vw,7rem)] font-700 leading-[0.9] tracking-tight text-on-dark">
          {page?.data?.hero_title}{' '}
          {page?.data?.hero_highlight && (
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange to-orange-light">{page.data.hero_highlight}</span>
          )}
        </h1>
        <p class="mt-10 text-on-dark-muted text-lg max-w-md leading-relaxed">{page?.data?.hero_description}</p>
      </div>

      <!-- Trust bar -->
      <div class="absolute bottom-0 right-0 z-[4] w-[58%] md:w-[45%]">
        <div class="absolute w-[24px] h-[24px] bg-cream z-[5]" style="bottom: 100%; right: 0; clip-path: path('M 0 0 L 24 0 A 24 24 0 0 0 0 24 Z'); transform: scaleX(-1) scaleY(-1);"></div>
        <div class="relative pl-3 pt-3 bg-cream" style="border-top-left-radius: 1.5rem;">
          <div class="absolute w-[24px] h-[24px] bg-cream" style="bottom: 0; right: 100%; clip-path: path('M 24 24 L 0 24 A 24 24 0 0 0 24 0 Z');"></div>
          <div class="relative overflow-hidden bg-cream" style="border-top-left-radius: 1rem;">
            <div class="relative z-[2] py-5 overflow-hidden">
              <div class="marquee-track" style="animation-duration: 40s;">
                {[...Array(6)].map(() => (
                  <span class="flex items-center gap-3 mx-8 flex-shrink-0 whitespace-nowrap">
                    <svg viewBox="0 0 36 36" fill="none" class="w-7 h-7 flex-shrink-0" style="animation: pulseRing 4s ease-in-out infinite;">
                      <path d="M18 3 L30 9 L30 18 C30 25.5 24.6 31.5 18 33 C11.4 31.5 6 25.5 6 18 L6 9 Z" fill="#FF5F00" opacity="0.12"/>
                      <path d="M18 3 L30 9 L30 18 C30 25.5 24.6 31.5 18 33 C11.4 31.5 6 25.5 6 18 L6 9 Z" stroke="#FF5F00" stroke-width="1.5" fill="none"/>
                      <path d="M13 18 L16.5 21.5 L23 14.5" stroke="#FF5F00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="font-display text-base md:text-lg font-600 text-ink tracking-tight trust-shimmer">Brought to you by experts in the field</span>
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    </div>

    <!-- ═══════ FEATURED POST ═══════ -->
    {featuredPost && featuredPost.data.featured_image?.src && (
      <section class="pt-28 md:pt-36 px-6 md:px-10 pb-16">
        <div class="flex flex-col md:flex-row md:items-end gap-6 mb-16">
          <span class="section-label">01</span>
          <h2 class="font-display text-5xl md:text-7xl font-700 tracking-tight text-dark leading-[0.9]">Latest Insights</h2>
        </div>
        <article class="relative min-h-[60vh] rounded-3xl overflow-hidden cursor-pointer group">
          <img class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt={featuredPost.data.title} src={featuredPost.data.featured_image.src} />
          <div class="absolute inset-0 bg-gradient-to-t from-dark via-dark/70 to-dark/20"></div>
          <div class="absolute inset-0 bg-orange/5 mix-blend-multiply"></div>
          <a href={`/posts/${featuredPost.id}`} class="absolute bottom-0 left-0 right-0 p-8 md:p-14 z-10 no-underline">
            <div class="flex items-center gap-4 mb-5">
              <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-orange bg-orange/15 px-3 py-1 rounded-full">Featured</span>
              <span class="font-mono text-[10px] tracking-wider text-white/50">{featuredPost.data.read_time}</span>
            </div>
            <h2 class="font-display text-3xl md:text-5xl font-700 tracking-tight text-white leading-[0.95] max-w-2xl group-hover:text-orange transition-colors duration-300">
              {featuredPost.data.title}
            </h2>
            <p class="text-white/60 text-base leading-relaxed mt-4 max-w-lg">{featuredPost.data.excerpt}</p>
            <div class="mt-8 flex items-center gap-3">
              <span class="font-display text-sm font-500 text-white">Read article</span>
              <svg class="text-orange group-hover:translate-x-2 transition-transform duration-300" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </a>
        </article>
      </section>
    )}

    <!-- ═══════ RECENT POSTS ═══════ -->
    {recentPosts.length > 0 && (
      <section class="px-6 md:px-10 pb-24">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {recentPosts.map((post: any) => (
            <a href={`/posts/${post.id}`} class="group cursor-pointer no-underline block">
              {post.data.featured_image?.src && (
                <div class="relative overflow-hidden rounded-2xl aspect-[3/2] mb-5">
                  <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt={post.data.title} src={post.data.featured_image.src} />
                  <div class="absolute inset-0 bg-orange/5 mix-blend-multiply"></div>
                </div>
              )}
              <div class="flex items-center gap-3 mb-3">
                <span class="font-mono text-[10px] tracking-[0.2em] text-orange uppercase">Insight</span>
                <span class="w-1 h-1 rounded-full bg-ink-faint"></span>
                <span class="font-mono text-[10px] text-ink-muted">{post.data.read_time}</span>
              </div>
              <h3 class="font-display text-xl font-600 text-dark group-hover:text-orange transition-colors duration-300">{post.data.title}</h3>
              <p class="text-ink-light text-sm line-clamp-2 mt-2 leading-relaxed">{post.data.excerpt}</p>
            </a>
          ))}
        </div>
        <div class="mt-12 text-center">
          <a href="/blog" class="inline-block bg-dark text-white px-8 py-4 rounded-full font-display text-sm font-500 cursor-pointer transition-all duration-300 hover:shadow-[0_20px_40px_rgba(11,11,11,0.2)] no-underline">
            View all articles
          </a>
        </div>
      </section>
    )}

    <!-- ═══════ CTA / NEWSLETTER ═══════ -->
    {page?.data?.cta_title && page.data.cta_style === 'newsletter' && (
      <section class="mesh-dark grain relative py-28 md:py-40 px-6 md:px-10 overflow-hidden">
        <div class="relative z-[3] max-w-3xl">
          <span class="section-label text-orange-light">02 — Connect</span>
          <h2 class="font-display text-5xl md:text-8xl font-700 tracking-tight text-on-dark leading-[0.85] mt-6">{page.data.cta_title}</h2>
          <p class="text-on-dark-muted text-lg leading-relaxed mt-6 mb-12 max-w-md">{page.data.cta_description}</p>
          <div class="max-w-md">
            <div class="flex items-center bg-white/5 border border-white/10 rounded-full overflow-hidden hover:border-orange/30 transition-colors duration-500">
              <input class="flex-grow py-4 px-6 text-sm font-body text-on-dark placeholder:text-on-dark-faint bg-transparent focus:outline-none" placeholder="Enter your business email" type="email" />
              <button class="bg-orange hover:bg-orange-dim text-white m-1.5 px-6 py-3 rounded-full font-display text-sm font-500 cursor-pointer transition-all duration-300 whitespace-nowrap hover:shadow-[0_0_30px_rgba(255,95,0,0.3)]">
                {page.data.cta_btn_text}
              </button>
            </div>
            <p class="mt-4 font-mono text-[10px] tracking-wider text-on-dark-faint ml-6">Join 15,000+ marketers. No spam.</p>
          </div>
        </div>
      </section>
    )}

  </main>

  <!-- ═══════ HERO CANVAS ═══════ -->
  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isRetina = window.devicePixelRatio > 1;

    (function heroCanvas() {
      const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
      if (!canvas) return;
      if (isRetina) { canvas.style.display = 'none'; return; }
      const ctx = canvas.getContext('2d')!;
      const section = document.getElementById('hero')!;
      let w = 0, h = 0;
      let mouse = { x: -9999, y: -9999, active: false };
      let smoothMouse = { x: -9999, y: -9999 };

      const LINE_COUNT = 40;
      const STEP = 8;

      function resize() {
        const r = section.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = r.width; h = r.height;
        canvas.width = w * dpr; canvas.height = h * dpr;
        canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function noise(x: number, y: number, t: number) {
        return Math.sin(x * 0.003 + t * 0.0004) * 0.6
             + Math.sin(y * 0.004 - t * 0.0003) * 0.4
             + Math.sin((x + y) * 0.002 + t * 0.0005) * 0.3
             + Math.cos(x * 0.005 - y * 0.003 + t * 0.0002) * 0.2;
      }

      function draw(time: number) {
        ctx.clearRect(0, 0, w, h);
        if (mouse.active) {
          smoothMouse.x += (mouse.x - smoothMouse.x) * 0.08;
          smoothMouse.y += (mouse.y - smoothMouse.y) * 0.08;
        } else {
          smoothMouse.x += (-9999 - smoothMouse.x) * 0.02;
          smoothMouse.y += (-9999 - smoothMouse.y) * 0.02;
        }
        for (let i = 0; i < LINE_COUNT; i++) {
          const baseY = (h / (LINE_COUNT - 1)) * i;
          const drift = Math.sin(time * 0.0003 + i * 0.7) * 25;
          let px = -20;
          let py = baseY + drift;
          ctx.beginPath();
          ctx.moveTo(px, py);
          const maxSteps = Math.ceil((w + 40) / STEP);
          for (let s = 0; s < maxSteps; s++) {
            const angle = noise(px, py, time) * 0.8;
            let dx = Math.cos(angle) * STEP;
            let dy = Math.sin(angle) * STEP * 0.6;
            const mx = px - smoothMouse.x;
            const my = py - smoothMouse.y;
            const mDist = Math.sqrt(mx * mx + my * my);
            const RADIUS = 250;
            if (mDist < RADIUS && mDist > 1) {
              const strength = ((RADIUS - mDist) / RADIUS);
              const curve = strength * strength * 4;
              dx += (-my / mDist) * curve * STEP * 0.5;
              dy += (mx / mDist) * curve * STEP * 0.5;
            }
            px += dx;
            py += dy;
            ctx.lineTo(px, py);
            if (px > w + 40) break;
          }
          const verticalPos = baseY / h;
          const edgeFade = 1 - Math.abs(verticalPos - 0.5) * 1.6;
          const alpha = Math.max(0, 0.03 + edgeFade * 0.04 + Math.sin(time * 0.001 + i * 0.3) * 0.015);
          ctx.strokeStyle = `rgba(255, 95, 0, ${alpha})`;
          ctx.lineWidth = 1 + edgeFade * 0.5;
          ctx.stroke();
        }
        if (mouse.active) {
          const grd = ctx.createRadialGradient(smoothMouse.x, smoothMouse.y, 0, smoothMouse.x, smoothMouse.y, 200);
          grd.addColorStop(0, 'rgba(255, 95, 0, 0.06)');
          grd.addColorStop(1, 'rgba(255, 95, 0, 0)');
          ctx.fillStyle = grd;
          ctx.fillRect(smoothMouse.x - 200, smoothMouse.y - 200, 400, 400);
        }
        if (!reducedMotion) requestAnimationFrame(draw);
      }

      section.addEventListener('mousemove', (e) => {
        const r = section.getBoundingClientRect();
        mouse.x = e.clientX - r.left;
        mouse.y = e.clientY - r.top;
        mouse.active = true;
      });
      section.addEventListener('mouseleave', () => { mouse.active = false; });
      window.addEventListener('resize', resize);
      resize();
      if (!reducedMotion) requestAnimationFrame(draw); else draw(0);
    })();
  </script>
</Base>
