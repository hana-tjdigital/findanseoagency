---
export const prerender = false;

import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import { extractText } from "../utils/reading-time";

const query = Astro.url.searchParams.get("q")?.trim() || "";
const { entries: allPosts } = await getEmDashCollection("posts");

function matchesQuery(post: (typeof allPosts)[0], q: string): boolean {
  if (!q) return false;
  const lower = q.toLowerCase();
  const title = (post.data.title || "").toLowerCase();
  const excerpt = (post.data.excerpt || "").toLowerCase();
  const content = extractText(post.data.content).toLowerCase();
  return title.includes(lower) || excerpt.includes(lower) || content.includes(lower);
}

const results = query ? allPosts.filter((p) => matchesQuery(p, query)) : [];
---

<Base title={query ? `Search: ${query}` : "Search"} description="Search blog posts">
  <section class="mesh-dark grain relative min-h-[50vh] flex items-end overflow-hidden">
    <div class="relative z-[3] px-6 md:px-10 pb-16 md:pb-20 w-full max-w-3xl">
      <span class="section-label text-orange-light mb-4 block">Find</span>
      <h1 class="font-display text-5xl md:text-7xl font-700 tracking-tight leading-[0.9] text-on-dark mb-10">Search</h1>

      <form method="get" action="/search" class="flex items-center bg-white/5 backdrop-blur-xl border border-white/10 rounded-full overflow-hidden hover:border-orange/30 transition-colors duration-500">
        <input
          type="search"
          name="q"
          value={query}
          placeholder="Search posts, agencies, guides..."
          class="flex-grow py-4 px-6 text-sm font-body text-on-dark placeholder:text-on-dark-faint bg-transparent focus:outline-none"
          autofocus
        />
        <button type="submit" class="bg-orange hover:bg-orange-dim text-white m-1.5 px-6 py-3 rounded-full font-display text-sm font-500 cursor-pointer transition-all duration-300 whitespace-nowrap hover:shadow-[0_0_30px_rgba(255,95,0,0.3)]">
          Search
        </button>
      </form>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-cream to-transparent z-[2]"></div>
  </section>

  <section class="px-6 md:px-10 py-16 max-w-4xl mx-auto">
    {query && (
      <p class="font-mono text-[11px] tracking-[0.15em] uppercase text-ink-muted mb-10">
        {results.length === 0
          ? `No results for "${query}"`
          : `${results.length} result${results.length === 1 ? "" : "s"} for "${query}"`}
      </p>
    )}

    {results.length > 0 && (
      <div class="divide-y divide-warm-gray">
        {results.map((post) => (
          <a href={`/posts/${post.id}`} class="service-row group py-8 block no-underline">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="font-display text-xl md:text-2xl font-600 text-dark group-hover:text-orange transition-colors duration-300">{post.data.title}</h3>
                {post.data.excerpt && <p class="text-ink-light text-sm mt-2 max-w-xl">{post.data.excerpt}</p>}
              </div>
              <svg class="text-ink-faint group-hover:text-orange group-hover:rotate-[-45deg] transition-all duration-500 flex-shrink-0 ml-4" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    )}

    {!query && <p class="text-ink-muted">Enter a search term to find posts.</p>}
  </section>
</Base>
